generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model WaitlistUser {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  nonce           String   @unique // Sequential number as string
  user_id         String   // Email or wallet address
  connection_type String   // "email" or "wallet"
  joined_at       DateTime @default(now())

  @@unique([user_id, connection_type])
  @@map("waitlist_users")
}